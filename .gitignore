# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
**/.esphome/
**/secrets.yaml
__pycache__/
**/__pycache__/
*.pyc
*.swp
deployment/
deployment/.venv/
/build/
/.opencode/
hardware/*.kicad_prl
hardware/generated/
# KiCad local recovery history and fabrication-toolkit preferences.
hardware/.history/
hardware/fabrication-toolkit-options.json
# Locally generated third-party JLCPCB/LCSC libraries and 3D models.
hardware/libs/
# Cached EasyEDA/LCSC responses and model downloads.
.easyeda_cache/
# Local backups of production output.
hardware/production/backups/
